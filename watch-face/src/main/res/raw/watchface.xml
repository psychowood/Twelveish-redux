<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <!-- Background Color -->
        <ColorConfiguration id="background_color" displayName="@string/label_background_color" defaultValue="0">
            <ColorOption id="0" displayName="@string/color_black" colors="#000000" />
            <ColorOption id="1" displayName="@string/color_dark_gray" colors="#222222" />
            <ColorOption id="2" displayName="@string/color_deep_blue" colors="#000033" />
            <ColorOption id="3" displayName="@string/color_red" colors="#ff0000" />
            <ColorOption id="4" displayName="@string/color_magenta" colors="#ff00ff" />
            <ColorOption id="5" displayName="@string/color_yellow" colors="#ffff00" />
            <ColorOption id="6" displayName="@string/color_green" colors="#00ff00" />
            <ColorOption id="7" displayName="@string/color_cyan" colors="#00ffff" />
            <ColorOption id="8" displayName="@string/color_blue" colors="#0000ff" />
            <ColorOption id="9" displayName="@string/color_white" colors="#ffffff" />
            <ColorOption id="10" displayName="@string/color_mat_red" colors="#A62C23" />
            <ColorOption id="11" displayName="@string/color_mat_pink" colors="#A61646" />
            <ColorOption id="12" displayName="@string/color_mat_purple" colors="#9224A6" />
            <ColorOption id="13" displayName="@string/color_mat_deep_purple" colors="#5E35A6" />
            <ColorOption id="14" displayName="@string/color_mat_indigo" colors="#3A4AA6" />
            <ColorOption id="15" displayName="@string/color_mat_blue" colors="#1766A6" />
            <ColorOption id="16" displayName="@string/color_mat_light_blue" colors="#0272A6" />
            <ColorOption id="17" displayName="@string/color_mat_cyan" colors="#0092A6" />
            <ColorOption id="18" displayName="@string/color_mat_teal" colors="#00A695" />
            <ColorOption id="19" displayName="@string/color_mat_green" colors="#47A64A" />
            <ColorOption id="20" displayName="@string/color_mat_light_green" colors="#76A63F" />
            <ColorOption id="21" displayName="@string/color_mat_lime" colors="#99A62B" />
            <ColorOption id="22" displayName="@string/color_mat_yellow" colors="#A69926" />
            <ColorOption id="23" displayName="@string/color_mat_amber" colors="#A67E05" />
            <ColorOption id="24" displayName="@string/color_mat_orange" colors="#A66300" />
            <ColorOption id="25" displayName="@string/color_mat_deep_orange" colors="#A63716" />
            <ColorOption id="26" displayName="@string/color_mat_brown" colors="#A67563" />
            <ColorOption id="27" displayName="@string/color_mat_gray" colors="#676767" />
            <ColorOption id="28" displayName="@string/color_mat_blue_gray" colors="#7295A6" />
            <ColorOption id="29" displayName="@string/color_gold" colors="#FFD700" />
            <ColorOption id="30" displayName="@string/color_sunset" colors="#F8B195" />
            <ColorOption id="31" displayName="@string/color_fog" colors="#A8A7A7" />
            <ColorOption id="32" displayName="@string/color_summer_red" colors="#fe4a49" />
            <ColorOption id="33" displayName="@string/color_aqua" colors="#2ab7ca" />
            <ColorOption id="34" displayName="@string/color_sun" colors="#fed766" />
            <ColorOption id="35" displayName="@string/color_dawn" colors="#451e3e" />
        </ColorConfiguration>
        <!-- Main Text Color -->
        <ColorConfiguration id="main_text_color" displayName="@string/label_text_color" defaultValue="0">
            <ColorOption id="0" displayName="@string/color_white" colors="#FFFFFF" />
            <ColorOption id="1" displayName="@string/color_orange" colors="#FF9800" />
            <ColorOption id="2" displayName="@string/color_blue" colors="#2196F3" />
            <ColorOption id="3" displayName="@string/color_gray_400" colors="#bdbdbd" />
            <ColorOption id="4" displayName="@string/color_gray_500" colors="#9e9e9e" />
            <ColorOption id="5" displayName="@string/color_gray_600" colors="#757575" />
            <ColorOption id="6" displayName="@string/color_gray_700" colors="#616161" />
            <ColorOption id="7" displayName="@string/color_gray_800" colors="#424242" />
            <ColorOption id="8" displayName="@string/color_gray_900" colors="#212121" />
            <ColorOption id="9" displayName="@string/color_black" colors="#000000" />
            <ColorOption id="10" displayName="@string/color_red" colors="#ff0000" />
            <ColorOption id="11" displayName="@string/color_magenta" colors="#ff00ff" />
            <ColorOption id="12" displayName="@string/color_yellow" colors="#ffff00" />
            <ColorOption id="13" displayName="@string/color_green" colors="#00ff00" />
            <ColorOption id="14" displayName="@string/color_cyan" colors="#00ffff" />
            <ColorOption id="15" displayName="@string/color_mat_red" colors="#A62C23" />
            <ColorOption id="16" displayName="@string/color_mat_pink" colors="#A61646" />
            <ColorOption id="17" displayName="@string/color_mat_purple" colors="#9224A6" />
            <ColorOption id="18" displayName="@string/color_mat_deep_purple" colors="#5E35A6" />
            <ColorOption id="19" displayName="@string/color_mat_indigo" colors="#3A4AA6" />
            <ColorOption id="20" displayName="@string/color_mat_blue" colors="#1766A6" />
            <ColorOption id="21" displayName="@string/color_mat_light_blue" colors="#0272A6" />
            <ColorOption id="22" displayName="@string/color_mat_cyan" colors="#0092A6" />
            <ColorOption id="23" displayName="@string/color_mat_teal" colors="#00A695" />
            <ColorOption id="24" displayName="@string/color_mat_green" colors="#47A64A" />
            <ColorOption id="25" displayName="@string/color_mat_light_green" colors="#76A63F" />
            <ColorOption id="26" displayName="@string/color_mat_lime" colors="#99A62B" />
            <ColorOption id="27" displayName="@string/color_mat_yellow" colors="#A69926" />
            <ColorOption id="28" displayName="@string/color_mat_amber" colors="#A67E05" />
            <ColorOption id="29" displayName="@string/color_mat_orange" colors="#A66300" />
            <ColorOption id="30" displayName="@string/color_mat_deep_orange" colors="#A63716" />
            <ColorOption id="31" displayName="@string/color_mat_brown" colors="#A67563" />
            <ColorOption id="32" displayName="@string/color_mat_gray" colors="#676767" />
            <ColorOption id="33" displayName="@string/color_mat_blue_gray" colors="#7295A6" />
            <ColorOption id="34" displayName="@string/color_gold" colors="#FFD700" />
            <ColorOption id="35" displayName="@string/color_sunset" colors="#F8B195" />
            <ColorOption id="36" displayName="@string/color_fog" colors="#A8A7A7" />
            <ColorOption id="37" displayName="@string/color_summer_red" colors="#fe4a49" />
            <ColorOption id="38" displayName="@string/color_aqua" colors="#2ab7ca" />
            <ColorOption id="39" displayName="@string/color_sun" colors="#fed766" />
            <ColorOption id="40" displayName="@string/color_dawn" colors="#451e3e" />
        </ColorConfiguration>
        <!-- Info Toggles -->
        <BooleanConfiguration id="show_battery" displayName="@string/label_show_battery" defaultValue="TRUE" />
        <BooleanConfiguration id="military_time" displayName="@string/label_military_time" defaultValue="FALSE" />
    </UserConfigurations>

    <Scene>
        <!-- Background -->
        <PartDraw name="Background" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="[CONFIGURATION.background_color]" />
            </Rectangle>
        </PartDraw>

        <!-- Top Info Group -->
        <Group name="TopInfo" x="0" y="30" width="450" height="80">
            <!-- Digital Clock -->
            <PartText name="DigitalTime" x="0" y="0" width="450" height="30">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="22" color="[CONFIGURATION.main_text_color]">
                        <Template>%s:%s%s
                            <Parameter expression="[CONFIGURATION.military_time] ? [HOUR_0_23] : [HOUR_1_12]" />
                            <Parameter expression="floor([MINUTE] / 10)" />
                            <Parameter expression="[MINUTE] % 10" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="SubInfoWithBattery" x="0" y="35" width="450" height="25">
                <Transform target="alpha" value="[CONFIGURATION.show_battery] ? 255 : 0" />
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="16" color="[CONFIGURATION.main_text_color]">
                        <Template><![CDATA[%s %s • %d%%]]>
                            <Parameter expression="[DAY_OF_WEEK_S]" />
                            <Parameter expression="[DAY]" />
                            <Parameter expression="[BATTERY_PERCENT]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
            <PartText name="SubInfoWithoutBattery" x="0" y="35" width="450" height="25">
                <Transform target="alpha" value="[CONFIGURATION.show_battery] ? 0 : 255" />
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="16" color="[CONFIGURATION.main_text_color]">
                        <Template><![CDATA[%s %s]]>
                            <Parameter expression="[DAY_OF_WEEK_S]" />
                            <Parameter expression="[DAY]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Main Fuzzy Time -->
        <Group name="FuzzyTimeGroup" x="50" y="130" width="350" height="220">

            <!-- Prefix segments -->
            <Group name="Prefix" x="0" y="0" width="350" height="60">
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] > 0 &amp;&amp; [MINUTE] &lt; 5 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_0_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 5 &amp;&amp; [MINUTE] &lt; 10 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_1_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 10 &amp;&amp; [MINUTE] &lt; 15 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_2_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 15 &amp;&amp; [MINUTE] &lt; 20 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_3_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 20 &amp;&amp; [MINUTE] &lt; 25 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_4_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 25 &amp;&amp; [MINUTE] &lt; 30 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_5_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 30 &amp;&amp; [MINUTE] &lt; 35 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_6_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 35 &amp;&amp; [MINUTE] &lt; 40 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_7_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 40 &amp;&amp; [MINUTE] &lt; 45 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_8_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 45 &amp;&amp; [MINUTE] &lt; 50 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_9_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 50 &amp;&amp; [MINUTE] &lt; 55 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_10_prefix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 55 &amp;&amp; [MINUTE] &lt; 60 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_11_prefix</Template></Font></Text></PartText>
            </Group>

            <!-- Hour segments -->
            <Group name="Hour" x="0" y="65" width="350" height="70">
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="([MINUTE] >= 40 ? ([HOUR_0_23] + 1) % 24 : [HOUR_0_23]) == 0 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_0</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="([MINUTE] >= 40 ? ([HOUR_0_23] + 1) % 24 : [HOUR_0_23]) == 12 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_12</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 1 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_1</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 2 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_2</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 3 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_3</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 4 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_4</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 5 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_5</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 6 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_6</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 7 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_7</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 8 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_8</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 9 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_9</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 10 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_10</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="70"><Transform target="alpha" value="(([MINUTE] >= 40 ? ([HOUR_1_12] % 12 + 1) : [HOUR_1_12])) == 11 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="54" color="[CONFIGURATION.main_text_color]"><Template>@string/hour_11</Template></Font></Text></PartText>
            </Group>

            <!-- Suffix segments -->
            <Group name="Suffix" x="0" y="135" width="350" height="60">
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] > 0 &amp;&amp; [MINUTE] &lt; 5 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_0_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 5 &amp;&amp; [MINUTE] &lt; 10 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_1_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 10 &amp;&amp; [MINUTE] &lt; 15 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_2_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 15 &amp;&amp; [MINUTE] &lt; 20 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_3_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 20 &amp;&amp; [MINUTE] &lt; 25 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_4_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 25 &amp;&amp; [MINUTE] &lt; 30 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_5_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 30 &amp;&amp; [MINUTE] &lt; 35 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_6_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 35 &amp;&amp; [MINUTE] &lt; 40 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_7_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 40 &amp;&amp; [MINUTE] &lt; 45 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_8_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 45 &amp;&amp; [MINUTE] &lt; 50 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_9_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 50 &amp;&amp; [MINUTE] &lt; 55 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_10_suffix</Template></Font></Text></PartText>
                <PartText x="0" y="0" width="350" height="60"><Transform target="alpha" value="[MINUTE] >= 55 &amp;&amp; [MINUTE] &lt; 60 ? 255 : 0" /><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" color="[CONFIGURATION.main_text_color]"><Template>@string/seg_11_suffix</Template></Font></Text></PartText>
            </Group>
        </Group>

        <!-- Complications -->
        <ComplicationSlot slotId="1" supportedTypes="SHORT_TEXT LONG_TEXT RANGED_VALUE MONOCHROMATIC_IMAGE EMPTY" x="75" y="350" width="80" height="80">
            <BoundingOval x="0" y="0" width="80" height="80" />
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                 <PartText x="0" y="0" width="80" height="80">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="24" color="[CONFIGURATION.main_text_color]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text>
                </PartText>
            </Complication>
            <Complication type="LONG_TEXT">
                 <PartText x="0" y="0" width="80" height="80">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.main_text_color]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                 <PartText x="0" y="0" width="80" height="80">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="24" color="[CONFIGURATION.main_text_color]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text>
                </PartText>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                 <PartImage x="20" y="20" width="40" height="40">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                 </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="2" supportedTypes="SHORT_TEXT LONG_TEXT RANGED_VALUE MONOCHROMATIC_IMAGE EMPTY" x="295" y="350" width="80" height="80">
            <BoundingOval x="0" y="0" width="80" height="80" />
            <DefaultProviderPolicy defaultSystemProvider="DATE" defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                 <PartText x="0" y="0" width="80" height="80">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="24" color="[CONFIGURATION.main_text_color]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text>
                </PartText>
            </Complication>
