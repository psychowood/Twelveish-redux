<?xml version="1.0" encoding="utf-8"?>
<UserConfigurations>
    <!-- Background Color -->
    <ColorConfiguration
        id="background_color"
        displayName="Background Color"
        defaultValue="0">
        <ColorOption id="0" displayName="Black" colors="#000000" />
        <ColorOption id="1" displayName="Dark Gray" colors="#222222" />
        <ColorOption id="2" displayName="Deep Blue" colors="#000033" />
        <ColorOption id="3" displayName="Forest Green" colors="#002200" />
    </ColorConfiguration>

    <!-- Main Text Color -->
    <ColorConfiguration
        id="main_text_color"
        displayName="Text Color"
        defaultValue="0">
        <ColorOption id="0" displayName="White" colors="#FFFFFF" />
        <ColorOption id="1" displayName="Classic Orange" colors="#FF9800" />
        <ColorOption id="2" displayName="Twelveish Blue" colors="#2196F3" />
        <ColorOption id="3" displayName="Soft Gray" colors="#AAAAAA" />
    </ColorConfiguration>

    <!-- Visibility Toggles -->
    <BooleanConfiguration
        id="show_battery"
        displayName="Show Battery Info"
        defaultValue="TRUE" />

    <BooleanConfiguration
        id="military_time"
        displayName="24h Digital Clock"
        defaultValue="FALSE" />

</UserConfigurations>
