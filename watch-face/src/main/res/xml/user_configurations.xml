<?xml version="1.0" encoding="utf-8"?>
<UserConfigurations>
    <!-- Background Color -->
    <ColorConfiguration
        id="background_color"
        displayName="@string/label_background_color"
        defaultValue="0">
        <ColorOption id="0" displayName="@string/color_black" colors="#000000" />
        <ColorOption id="1" displayName="@string/color_dark_gray" colors="#222222" />
        <ColorOption id="2" displayName="@string/color_deep_blue" colors="#000033" />
    </ColorConfiguration>

    <!-- Main Text Color -->
    <ColorConfiguration
        id="main_text_color"
        displayName="@string/label_text_color"
        defaultValue="0">
        <ColorOption id="0" displayName="@string/color_white" colors="#FFFFFF" />
        <ColorOption id="1" displayName="@string/color_orange" colors="#FF9800" />
        <ColorOption id="2" displayName="@string/color_blue" colors="#2196F3" />
    </ColorConfiguration>

    <!-- Visibility Toggles -->
    <BooleanConfiguration
        id="show_battery"
        displayName="@string/label_show_battery"
        defaultValue="TRUE" />

    <BooleanConfiguration
        id="military_time"
        displayName="@string/label_military_time"
        defaultValue="FALSE" />

</UserConfigurations>
